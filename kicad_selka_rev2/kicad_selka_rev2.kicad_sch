		(company "ELEKTRONIIKKAKERHO")
		(comment 1 "Possulamasta 64 ledinen versio 2x charlieplexaamalla ja selkään kiinni!")
		(comment 2 "Cyaanin väriset viivat viittaa siihen, että piiri sijaitsee alemmalla levyllä,")
		(comment 3 "Beige piiri kuormittaa virtapankkia ajoittain, jottei virtapankki sammu. ")
		(comment 4 "Harmaat viivat ohjelmointia varten. J19 ja J20 väliin voi laitta namiskan.")
		(comment 6 "Jan Tapio Äärelä")
	)
