(kicad_wks
	(version 20231118)
	(generator "pl_editor")
	(generator_version "9.0")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "")
		(start 110 41 lbcorner)
		(end 2 2 lbcorner)
		(comment "rect around the title block")
	)
	(rect
		(name "")
		(start 0 0 ltcorner)
		(end 0 0)
		(repeat 2)
		(incrx 2)
		(incry 2)
	)
	(line
		(name "")
		(start 50 2 ltcorner)
		(end 50 0 ltcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 50 2 lbcorner)
		(end 50 0 lbcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 lbcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 0 50 ltcorner)
		(end 2 50 ltcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(line
		(name "")
		(start 0 50 rtcorner)
		(end 2 50 rtcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 rtcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(tbtext "Date: ${ISSUE_DATE}"
		(name "")
		(pos 26.04 6.9002 lbcorner)
	)
	(line
		(name "")
		(start 110 5.5 lbcorner)
		(end 2 5.5 lbcorner)
	)
	(tbtext "${KICAD_VERSION}"
		(name "")
		(pos 2.32 3.7 lbcorner)
		(comment "Kicad version")
	)
	(line
		(name "")
		(start 110 8.5 lbcorner)
		(end 2 8.5 lbcorner)
	)
	(tbtext "Rev: ${REVISION}"
		(name "")
		(pos 2.32 6.9 lbcorner)
		(font bold)
	)
	(tbtext "Size: ${PAPER}"
		(name "")
		(pos 91.22 6.9002 lbcorner)
		(comment "Paper format name")
	)
	(tbtext "Id: ${#}/${##}"
		(name "")
		(pos 26.54 3.7 lbcorner)
		(comment "Sheet id")
	)
	(line
		(name "")
		(start 110 12.5 lbcorner)
		(end 2 12.5 lbcorner)
	)
	(tbtext "Title: ${TITLE}"
		(name "")
		(pos 2.32 10.7002 lbcorner)
		(font
			(size 2 2) bold italic)
	)
	(tbtext "File: ${FILENAME}"
		(name "")
		(pos 2.32 14.3002 lbcorner)
	)
	(line
		(name "")
		(start 110 18.5 lbcorner)
		(end 2 18.5 lbcorner)
	)
	(tbtext "Sheet: ${SHEETPATH}"
		(name "")
		(pos 2.32 17.0002 lbcorner)
	)
	(tbtext "${COMPANY}"
		(name "")
		(pos 2.32 20.0002 lbcorner)
		(font bold)
		(comment "Company name")
	)
	(tbtext "${COMMENT1}"
		(name "")
		(pos 2.32 38.7482 lbcorner)
		(comment "Comment 0")
	)
	(tbtext "${COMMENT2}"
		(name "")
		(pos 2.32 35.6522 lbcorner)
		(comment "Comment 1")
	)
	(tbtext "${COMMENT3}"
		(name "")
		(pos 2.32 32.5562 lbcorner)
		(comment "Comment 2")
	)
	(tbtext "${COMMENT4}"
		(name "")
		(pos 2.32 29.4602 lbcorner)
		(comment "Comment 3")
	)
	(line
		(name "")
		(start 90 8.5 lbcorner)
		(end 90 5.5 lbcorner)
	)
	(line
		(name "")
		(start 26 8.5 lbcorner)
		(end 26 2 lbcorner)
	)
	(tbtext "${COMMENT5}"
		(name "")
		(pos 2.32 26.3982 lbcorner)
		(comment "Comment 5")
	)
	(tbtext "${COMMENT6}"
		(name "")
		(pos 2.32 23.35 lbcorner)
		(comment "Comment 6")
	)
)
